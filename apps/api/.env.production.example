# Merge these domain settings into the EXISTING production environment.
# Preserve SECRET_KEY, database credentials, storage credentials and volume names.
DEBUG=False
ALLOWED_HOSTS=api.heledone.com,panel.heledone.com,localhost,127.0.0.1,api,madar-api
ALLOWED_CORS=https://panel.heledone.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://panel.heledone.com,https://api.heledone.com
TRUST_PROXY_PROTO=True
API_PUBLIC_URL=https://api.heledone.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Keep the internal S3 endpoint unchanged; only generated public URLs change.
AWS_S3_CUSTOM_DOMAIN=api.heledone.com/storage/madar-media
AWS_S3_URL_PROTOCOL=https:

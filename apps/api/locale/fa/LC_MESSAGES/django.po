msgstr " اعضای سازمان"

msgid " Back to Main Menu"
msgstr " بازگشت به منوی اصلی"

msgid " Back to Menu"
msgstr " بازگشت به منو"

msgid " Back to Admin Panel"
msgstr " بازگشت به پنل مدیریت"

msgid " <b>Error:</b> Invalid connection link.\n\nPlease click on the \"Connect to Telegram\" button from your site dashboard to enter the bot."
msgstr " <b>خطا:</b> لینک اتصال نامعتبر است.\n\nلطفاً از طریق پنل کاربری سایت روی دکمه «اتصال به تلگرام» کلیک کنید تا وارد بات شوید."

msgid " <b>The link has expired or is invalid!</b>\n\nPlease generate a new connection link from the website."
msgstr " <b>لینک منقضی شده یا نامعتبر است!</b>\n\nلطفاً مجدداً از وب‌سایت اقدام به تولید لینک اتصال کنید."

msgid " <b>Connection Error!</b>\n\nThis Telegram account is already connected to another user account in the Madaar system. Each Telegram account can only be connected to one site account."
msgstr " <b>خطا در اتصال!</b>\n\nاین اکانت تلگرام شما قبلاً به یک حساب کاربری دیگر در سیستم مدار متصل شده است. هر حساب تلگرام فقط می‌تواند به یک اکانت سایت متصل باشد."

msgid ""
" <b>Hello dear {name}!</b>\n\n"
" Your user account has been successfully connected to the <b>Madaar</b> bot.\n"
"From now on, your important work notifications will be sent here immediately.\n\n"
"Use the menu below:"
msgstr ""
" <b>سلام {name} عزیز!</b>\n\n"
" حساب کاربری شما با موفقیت به ربات <b>مدار</b> متصل شد.\n"
"از این پس اعلان‌های مهم کاری شما بلافاصله اینجا ارسال خواهد شد.\n\n"
"از منوی زیر استفاده کنید:"

msgid "User"
msgstr "کاربر"

msgid " <b>Madaar Bot Main Menu</b>\n\nHello {name}! Use the buttons below:"
msgstr " <b>منوی اصلی ربات مدار</b>\n\nسلام {name}! از دکمه‌های زیر استفاده کنید:"

msgid ""
" <b>Madaar Bot Help</b>\n\n"
" /start — Connect user account\n"
" /status — Connection status\n"
" /myprojects — My projects list\n"
" /mytasks — My tasks list\n"
" /myorg — My organization info\n"
" /help — Show this help message\n\n"
"<i> This bot automatically sends your work notifications.</i>"
msgstr ""
" <b>راهنمای ربات مدار</b>\n\n"
" /start — اتصال حساب کاربری\n"
" /status — وضعیت اتصال\n"
" /myprojects — لیست پروژه‌های من\n"
" /mytasks — لیست تسک‌های من\n"
" /myorg — اطلاعات سازمان من\n"
" /help — نمایش همین راهنما\n\n"
"<i> این ربات به صورت خودکار اعلان‌های کاری شما را ارسال می‌کند.</i>"

msgid " <b>Language Selection</b>\n\nPlease select your preferred language:"
msgstr " <b>انتخاب زبان / Language Selection</b>\n\nلطفاً زبان مورد نظر خود را انتخاب کنید:"

msgid " Active"
msgstr " فعال"

msgid " Inactive"
msgstr " غیرفعال"

msgid ""
" <b>User Account Status</b>\n\n"
" <b>Name:</b> {name}\n"
" <b>Email:</b> {email}\n\n"
"<b>Notification Channels:</b>\n"
"  Telegram: {tg_status}\n"
"  Email: {email_status}"
msgstr ""
" <b>وضعیت حساب کاربری</b>\n\n"
" <b>نام:</b> {name}\n"
" <b>ایمیل:</b> {email}\n\n"
"<b>کانال‌های اعلان:</b>\n"
"  تلگرام: {tg_status}\n"
"  ایمیل: {email_status}"

msgid ""
" <b>Connection Status:</b> Disconnected\n\n"
"You have not connected your user account yet.\n"
"To connect, send the /start command."
msgstr ""
" <b>وضعیت اتصال:</b> قطع\n\n"
"شما هنوز حساب کاربری خود را متصل نکرده‌اید.\n"
"برای اتصال، دستور /start را ارسال کنید."

msgid " Please connect your account with /start first."
msgstr " ابتدا حساب خود را با /start متصل کنید."

msgid " <b>My Projects</b>\n\n"
msgstr " <b>پروژه‌های من</b>\n\n"

msgid "You are currently not a member of any active project."
msgstr "شما در حال حاضر عضو هیچ پروژه فعالی نیستید."

msgid "\n<i>Total: {count} projects</i>"
msgstr "\n<i>مجموع: {count} پروژه</i>"

msgid " <b>My Tasks</b>\n\n"
msgstr " <b>تسک‌های من</b>\n\n"

msgid " You have no open and unfinished tasks! Well done!"
msgstr " هیچ تسک باز و ناتمامی ندارید! آفرین!"

msgid " <b>My Tasks (Open)</b>\n"
msgstr " <b>تسک‌های من (باز)</b>\n"

msgid "\n<i>Showing {count} of {total} open tasks</i>"
msgstr "\n<i>نمایش {count} از {total} تسک باز</i>"

msgid " You are the owner of organization <b>{org}</b> ( {count} members)"
msgstr " شما مالک سازمان <b>{org}</b> هستید ( {count} عضو)"

msgid " You are a member of organization <b>{org}</b> ( Role: {role})"
msgstr " شما عضو سازمان <b>{org}</b> هستید ( نقش: {role})"

msgid " <b>My Organization</b>\n\n"
msgstr " <b>سازمان من</b>\n\n"

msgid "You are not a member of any organization yet."
msgstr "شما هنوز عضو هیچ سازمانی نیستید."

msgid " <b>Organizations related to me</b>\n"
msgstr " <b>سازمان‌های مرتبط با من</b>\n"

msgid " Unauthorized access."
msgstr " دسترسی غیرمجاز."

msgid ""
" <b>Superadmin Panel</b>\n\n"
" <b>Overall System Statistics:</b>\n\n"
" <b>Number of Organizations:</b> {org_count}\n"
" <b>Number of Users:</b> {user_count}\n"
" <b>Number of Projects:</b> {project_count}\n\n"
"<i>(Special Admin Access)</i>"
msgstr ""
" <b>پنل ادمین کل سیستم (Superadmin)</b>\n\n"
" <b>آمار کل سیستم:</b>\n\n"
" <b>تعداد سازمان‌ها:</b> {org_count}\n"
" <b>تعداد کاربران:</b> {user_count}\n"
" <b>تعداد پروژه‌ها:</b> {project_count}\n\n"
"<i>(دسترسی ویژه ادمین)</i>"

msgid ""
" <b>Organization Admin Panel ({org})</b>\n\n"
"Use the sections below to view the overall status of the organization:"
msgstr ""
" <b>پنل مدیریت سازمان ({org})</b>\n\n"
"از بخش‌های زیر برای مشاهده وضعیت کلان سازمان استفاده کنید:"

msgid ""
" <b>Organization Overall Dashboard</b>\n\n"
" <b>Organization Name:</b> {org}\n\n"
" <b>Number of Personnel:</b> {members} people\n"
" <b>Projects:</b> {projects} (Active: {active})\n"
" <b>Open Tasks:</b> {tasks} tasks"
msgstr ""
" <b>داشبورد کلان سازمان</b>\n\n"
" <b>نام سازمان:</b> {org}\n\n"
" <b>تعداد پرسنل:</b> {members} نفر\n"
" <b>پروژه‌ها:</b> {projects} (فعال: {active})\n"
" <b>تسک‌های باز:</b> {tasks} تسک"

msgid "No projects are registered in the organization."
msgstr "هیچ پروژه‌ای در سازمان ثبت نشده است."

msgid " <b>Organization Projects ({org})</b>\n"
msgstr " <b>پروژه‌های سازمان ({org})</b>\n"

msgid "\n<i>Showing {count} of {total} projects</i>"
msgstr "\n<i>نمایش {count} از {total} پروژه</i>"

msgid ""
" <b>Organization Tasks Status</b>\n\n"
" <b>Total Tasks:</b> {total}\n\n"
" <b>Done:</b> {done} tasks\n"
" <b>In Progress:</b> {in_progress} tasks\n"
" <b>Waiting for Review:</b> {review} tasks\n"
" <b>Not Started (Todo):</b> {todo} tasks"
msgstr ""
" <b>وضعیت تسک‌های سازمان</b>\n\n"
" <b>مجموع کل تسک‌ها:</b> {total}\n\n"
" <b>انجام شده:</b> {done} تسک\n"
" <b>در حال انجام:</b> {in_progress} تسک\n"
" <b>در انتظار بررسی:</b> {review} تسک\n"
" <b>شروع نشده (Todo):</b> {todo} تسک"

msgid " <b>Organization Members ({org})</b>\n"
msgstr " <b>اعضای سازمان ({org})</b>\n"

msgid "\n<i>Showing {count} of {total} members</i>"
msgstr "\n<i>نمایش {count} از {total} عضو</i>"

msgid ""
" <b>Your account is temporarily blocked!</b>\n\n"
"Due to sending consecutive invalid messages (spam), your access to the bot "
"is blocked for <b>5 minutes</b>.\n\n"
"Please only use bot menus and buttons after this time."

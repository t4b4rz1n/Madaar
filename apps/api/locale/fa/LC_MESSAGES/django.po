#: automations/services.py - language change
msgid " Language successfully updated."
msgstr " زبان شما با موفقیت به روز شد."

#: automations/rules.py - _fmt_project_created
msgid "Added to project"
msgstr "عضو جدید پروژه"

msgid " <b>You have been added to a new project!</b>\n\nYou were added by {creator} to project <b>{project}</b>. Good luck!"
msgstr " <b>پروژه جدید ایجاد شد!</b>\n\nشما توسط {creator} به پروژه <b>{project}</b> اضافه شدید. موفق باشید!"

msgid "your colleague"
msgstr "همکار شما"

#: automations/rules.py - _fmt_project_member_removed
msgid "Removed from project"
msgstr "حذف از پروژه"

msgid " <b>You have been removed from a project!</b>\n\nYour access to project <b>{project}</b> was revoked by {remover}."
msgstr " <b>شما از پروژه حذف شدید!</b>\n\nتوسط {remover} دسترسی شما از پروژه <b>{project}</b> قطع شد."

msgid "system admin"
msgstr "مدیر سیستم"

#: automations/rules.py - _fmt_project_over_budget
msgid "Project budget warning"
msgstr "هشدار بودجه پروژه"

msgid " <b>Budget warning!</b>\n\nThe budget for project <b>{project}</b> is running low or has been exceeded.\nPlease review."
msgstr " <b>هشدار بودجه!</b>\n\nبودجه پروژه <b>{project}</b> رو به اتمام است یا از حد مجاز عبور کرده.\nلطفاً بررسی کنید."

#: automations/rules.py - _fmt_milestone_approaching
msgid "Milestone deadline approaching"
msgstr "نزدیک شدن به پایان فاز"

msgid " <b>Deadline approaching!</b>\n\nLess than 48 hours remain until milestone <b>{milestone}</b> in project <b>{project}</b>."
msgstr " <b>ددلاین نزدیک است!</b>\n\nکمتر از ۴۸ ساعت تا پایان فاز <b>{milestone}</b> در پروژه <b>{project}</b> باقی مانده."

#: automations/rules.py - _fmt_milestone_completed
msgid "Milestone completed"
msgstr "فاز تکمیل شد"

msgid " <b>Milestone completed!</b>\n\nMilestone <b>{milestone}</b> in project <b>{project}</b> has been successfully completed. Great job!"
msgstr " <b>فاز تکمیل شد!</b>\n\nفاز <b>{milestone}</b> در پروژه <b>{project}</b> با موفقیت به پایان رسید. خسته نباشید!"

#: automations/rules.py - _fmt_task_assigned
msgid "New task assigned"
msgstr "تسک جدید"

msgid " <b>A new task has been assigned to you!</b>\n\n Task: <b>{task}</b>\n By: {assigner}"
msgstr " <b>تسک جدید به شما محول شد!</b>\n\n تسک: <b>{task}</b>\n توسط: {assigner}"

msgid "manager"
msgstr "مدیر"


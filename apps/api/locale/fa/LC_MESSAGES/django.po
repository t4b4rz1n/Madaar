msgstr " زبان / Language"

msgid " Organization Admin Panel"
msgstr " پنل مدیریت سازمان"

msgid " Superadmin Panel"
msgstr " پنل ادمین کل سیستم"

msgid " Overall Dashboard"
msgstr " داشبورد کلان"

msgid " Organization Projects"
msgstr " پروژه‌های سازمان"

msgid " Tasks Status"
msgstr " وضعیت تسک‌ها"

